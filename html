// CALENDAR
const HU_M=['Január','Február','Március','Április','Május','Június','Július','Augusztus','Szeptember','Október','November','December'];
const HU_D=['Hétfő','Kedd','Szerda','Csütörtök','Péntek','Szombat','Vasárnap'];
const HU_DS=['Hé','Ke','Sze','Csü','Pé','Szo','Va'];
let calY=2025, calM=4;

function calMove(d){ calM+=d; if(calM>11){calM=0;calY++;} if(calM<0){calM=11;calY--;} renderCalendar(); }

function renderCalendar(){
  document.getElementById('calLabel').textContent=HU_M[calM]+' '+calY;
  const todayStr=new Date().toISOString().slice(0,10);
  const evMap={};
  events.forEach(e=>{ if(!evMap[e.date]) evMap[e.date]=[]; evMap[e.date].push(e); });

  const firstDow=(new Date(calY,calM,1).getDay()+6)%7;
  const daysInM=new Date(calY,calM+1,0).getDate();
  const daysInPrev=new Date(calY,calM,0).getDate();
  const total=Math.ceil((firstDow+daysInM)/7)*7;

  let html=HU_DS.map(d=>`<div class="cal-day-name">${d}</div>`).join('');

  for(let i=0;i<total;i++){
    let dn, ds, isCur=true;
    if(i<firstDow){ dn=daysInPrev-firstDow+1+i; const pm=calM===0?12:calM; const py=calM===0?calY-1:calY; ds=`${py}-${String(pm).padStart(2,'0')}-${String(dn).padStart(2,'0')}`; isCur=false; }
    else if(i-firstDow>=daysInM){ dn=i-firstDow-daysInM+1; const nm=calM===11?1:calM+2; const ny=calM===11?calY+1:calY; ds=`${ny}-${String(nm).padStart(2,'0')}-${String(dn).padStart(2,'0')}`; isCur=false; }
    else{ dn=i-firstDow+1; ds=`${calY}-${String(calM+1).padStart(2,'0')}-${String(dn).padStart(2,'0')}`; }

    const evs=evMap[ds]||[];
    let cls='cal-day'+(isCur?'':' other-month')+(ds===todayStr?' today':'')+(evs.length?' has-ev':'');
    const numHtml=`<div class="cal-day-num">${dn}</div>`;
    const chips=evs.slice(0,2).map(ev=>`<span class="cal-event-chip ${ev.chip}" onclick="event.stopPropagation();openBooking(${ev.id})">${ev.icon} ${ev.title}</span>`).join('');
    const more=evs.length>2?`<span class="cal-more">+${evs.length-2} további</span>`:'';
    html+=`<div class="${cls}">${numHtml}${chips}${more}</div>`;
  }
  document.getElementById('calGrid').innerHTML=html;

  const cats=[...new Set(events.map(e=>e.cat))];
  const dotMap={Zene:'var(--sage-light)',Sport:'var(--sky)',Gasztro:'var(--peach)',Kultúra:'var(--lavender)',Tech:'var(--butter)',Természet:'var(--sage-light)'};
  document.getElementById('calLegend').innerHTML=
    `<div class="cal-leg"><div class="cal-leg-dot" style="background:var(--sage);border-radius:50%"></div>Mai nap</div>`+
    cats.map(c=>`<div class="cal-leg"><div class="cal-leg-dot" style="background:${dotMap[c]||'var(--sage-light)'}"></div>${c}</div>`).join('');
}

// INIT
renderNav();
renderEvents();
</script>
</body>
</html>
