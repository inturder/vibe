<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vibe — Eseménykereső</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root {
  --sage:#8BAF8B; --sage-light:#C4D8C4; --sage-pale:#EEF4EE;
  --peach:#E8A98C; --peach-light:#F5D4C4; --peach-pale:#FBF0EB;
  --sky:#A8C5D8; --sky-pale:#EBF3F8;
  --lavender:#C4AEDD; --lavender-pale:#F3EEF9;
  --butter:#E8D48C; --butter-pale:#FBF7EB;
  --cream:#FBF8F4; --brown-soft:#5C4A3A;
  --text:#2D2820; --text-muted:#7A6E64; --text-light:#B0A89E;
  --white:#FFFFFF; --border:rgba(92,74,58,0.1); --border-hover:rgba(92,74,58,0.2);
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text);min-height:100vh;overflow-x:hidden;}

nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:1.1rem 2.5rem;background:rgba(251,248,244,0.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
.logo{font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:600;color:var(--brown-soft);letter-spacing:-0.3px;cursor:pointer;}
.logo span{color:var(--sage);}
.nav-links{display:flex;gap:1.5rem;align-items:center;}
.nav-links a{text-decoration:none;font-size:0.875rem;font-weight:400;color:var(--text-muted);transition:color 0.2s;cursor:pointer;}
.nav-links a:hover{color:var(--text);}
.nav-links a.active{color:var(--sage);font-weight:500;}
.nav-cta{background:var(--brown-soft)!important;color:var(--white)!important;padding:0.45rem 1.1rem;border-radius:50px;font-weight:500!important;}
.nav-user{display:flex;align-items:center;gap:8px;cursor:pointer;}
.nav-avatar{width:32px;height:32px;border-radius:50%;background:var(--sage);color:white;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:600;}

.page{display:none;} .page.active{display:block;}

.hero{padding:8rem 2.5rem 4rem;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;max-width:1100px;margin:0 auto;min-height:90vh;}
.hero-tag{display:inline-flex;align-items:center;gap:6px;background:var(--sage-pale);border:1px solid var(--sage-light);color:var(--sage);border-radius:50px;padding:0.3rem 0.9rem;font-size:0.8rem;font-weight:500;margin-bottom:1.5rem;animation:fadeUp 0.6s ease both;}
.hero-tag::before{content:'';width:7px;height:7px;background:var(--sage);border-radius:50%;}
.hero-h1{font-family:'Playfair Display',serif;font-size:clamp(2.6rem,5vw,3.8rem);font-weight:600;line-height:1.15;color:var(--text);margin-bottom:1.2rem;animation:fadeUp 0.6s 0.1s ease both;}
.hero-h1 em{font-style:italic;color:var(--sage);}
.hero-p{font-size:1.05rem;line-height:1.75;color:var(--text-muted);margin-bottom:2.5rem;max-width:440px;animation:fadeUp 0.6s 0.2s ease both;}
.hero-search{display:flex;border-radius:50px;overflow:hidden;border:1px solid var(--border-hover);background:var(--white);box-shadow:0 4px 24px rgba(92,74,58,0.08);animation:fadeUp 0.6s 0.3s ease both;}
.hero-search input{flex:1;border:none;outline:none;padding:0.95rem 1.4rem;font-family:'DM Sans',sans-serif;font-size:0.95rem;background:transparent;color:var(--text);}
.hero-search input::placeholder{color:var(--text-light);}
.hero-search button{background:var(--sage);color:white;border:none;padding:0.9rem 1.6rem;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:0.9rem;font-weight:500;transition:background 0.2s;}
.hero-search button:hover{background:#7a9e7a;}
.hero-stats{display:flex;gap:2rem;margin-top:2rem;animation:fadeUp 0.6s 0.4s ease both;}
.stat{display:flex;flex-direction:column;gap:1px;}
.stat-num{font-size:1.5rem;font-weight:600;color:var(--text);}
.stat-label{font-size:0.8rem;color:var(--text-muted);}

.hero-visual{position:relative;animation:fadeUp 0.7s 0.2s ease both;}
.hero-card-stack{position:relative;height:440px;}
.hcard{position:absolute;border-radius:24px;padding:1.5rem;border:1px solid rgba(255,255,255,0.8);}
.hcard-main{bottom:0;left:0;right:0;height:280px;background:var(--white);box-shadow:0 8px 40px rgba(92,74,58,0.12);display:flex;flex-direction:column;justify-content:space-between;}
.hcard-float1{top:0;right:0;width:200px;background:linear-gradient(135deg,#C4D8C4,#8BAF8B);box-shadow:0 6px 24px rgba(139,175,139,0.35);color:white;}
.hcard-float2{top:80px;left:-20px;width:160px;background:linear-gradient(135deg,#F5D4C4,#E8A98C);box-shadow:0 6px 24px rgba(232,169,140,0.35);color:white;padding:1rem;}
.hcard-emoji{font-size:2rem;margin-bottom:0.5rem;}
.hcard-tag{display:inline-block;background:rgba(255,255,255,0.25);font-size:0.7rem;padding:2px 8px;border-radius:50px;margin-bottom:0.5rem;font-weight:500;}
.hcard-title-sm{font-size:1rem;font-weight:600;line-height:1.3;}
.hcard-date-sm{font-size:0.75rem;opacity:0.8;margin-top:4px;}
.hcard-img-area{width:100%;height:140px;border-radius:14px;background:linear-gradient(135deg,var(--sage-pale),var(--sky-pale));display:flex;align-items:center;justify-content:center;font-size:3.5rem;margin-bottom:1rem;}
.hcard-info h3{font-size:1rem;font-weight:600;color:var(--text);}
.hcard-info p{font-size:0.8rem;color:var(--text-muted);}
.hcard-footer{display:flex;align-items:center;justify-content:space-between;}
.hcard-price{font-weight:600;color:var(--text);font-size:0.95rem;}
.hcard-btn-sm{background:var(--sage);color:white;border:none;cursor:pointer;padding:0.4rem 0.9rem;border-radius:50px;font-size:0.8rem;font-family:'DM Sans',sans-serif;font-weight:500;}
.deco-dot{position:absolute;border-radius:50%;animation:float 4s ease-in-out infinite;}
.dot1{width:80px;height:80px;background:var(--butter-pale);border:2px solid var(--butter);top:-30px;left:60px;animation-delay:0s;}
.dot2{width:40px;height:40px;background:var(--lavender-pale);border:2px solid var(--lavender);bottom:30px;right:-20px;animation-delay:1.5s;}
.dot3{width:24px;height:24px;background:var(--peach-pale);border:2px solid var(--peach-light);top:50%;right:20px;animation-delay:0.8s;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-12px);}}

.featured-section{padding:2rem 2.5rem;max-width:1100px;margin:0 auto;}
.section-label{font-size:0.78rem;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:1.2rem;}
.featured-card{background:var(--white);border-radius:24px;border:1px solid var(--border);display:grid;grid-template-columns:1fr 2fr;overflow:hidden;box-shadow:0 4px 24px rgba(92,74,58,0.07);}
.featured-img{background:linear-gradient(135deg,#C4D8C4 0%,#8BAF8B 100%);display:flex;align-items:center;justify-content:center;font-size:5rem;min-height:220px;}
.featured-body{padding:2rem;display:flex;flex-direction:column;justify-content:space-between;}
.feat-tag{display:inline-block;background:var(--sage-pale);color:var(--sage);font-size:0.75rem;font-weight:500;padding:4px 12px;border-radius:50px;margin-bottom:0.75rem;border:1px solid var(--sage-light);}
.feat-title{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:600;color:var(--text);margin-bottom:0.5rem;line-height:1.2;}
.feat-meta{font-size:0.88rem;color:var(--text-muted);line-height:1.7;margin-bottom:1.5rem;}
.feat-actions{display:flex;gap:10px;align-items:center;}
.feat-btn-primary{background:var(--sage);color:white;border:none;padding:0.7rem 1.6rem;border-radius:50px;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:0.9rem;font-weight:500;transition:background 0.2s;}
.feat-btn-primary:hover{background:#7a9e7a;}
.feat-btn-ghost{background:transparent;color:var(--text-muted);border:1px solid var(--border-hover);padding:0.65rem 1.4rem;border-radius:50px;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:0.9rem;transition:all 0.2s;}
.feat-btn-ghost:hover{background:var(--sage-pale);color:var(--text);}

.cats-section{padding:2rem 2.5rem 1rem;max-width:1100px;margin:0 auto;}
.cats-grid{display:flex;flex-wrap:wrap;gap:10px;}
.cat-pill{display:flex;align-items:center;gap:8px;padding:0.6rem 1.2rem;border-radius:50px;border:1px solid var(--border);background:var(--white);font-size:0.88rem;font-weight:400;color:var(--text-muted);cursor:pointer;transition:all 0.2s;user-select:none;}
.cat-pill:hover,.cat-pill.active{border-color:var(--border-hover);background:var(--sage-pale);color:var(--brown-soft);font-weight:500;}
.cat-pill.active{background:var(--sage);color:white;border-color:var(--sage);}

.view-btn{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:6px 14px;font-size:0.82rem;cursor:pointer;color:var(--text-muted);font-family:'DM Sans',sans-serif;transition:all 0.18s;}
.view-btn.active{background:var(--sage);color:white;border-color:var(--sage);}

.events-section{padding:1rem 2.5rem 5rem;max-width:1100px;margin:0 auto;}
.events-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.8rem;flex-wrap:wrap;gap:1rem;}
.events-title{font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:600;color:var(--text);}
.events-count{font-size:0.85rem;color:var(--text-light);}
.events-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;}
.event-card{background:var(--white);border-radius:20px;border:1px solid var(--border);overflow:hidden;cursor:pointer;transition:transform 0.22s ease,box-shadow 0.22s ease,border-color 0.22s;display:flex;flex-direction:column;}
.event-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(92,74,58,0.1);border-color:var(--border-hover);}
.ec-img{height:160px;display:flex;align-items:center;justify-content:center;font-size:4rem;position:relative;overflow:hidden;}
.ec-badge{position:absolute;top:12px;left:12px;font-size:0.72rem;font-weight:500;padding:4px 11px;border-radius:50px;}
.ec-body{padding:1.2rem;flex:1;display:flex;flex-direction:column;}
.ec-title{font-weight:600;font-size:1rem;color:var(--text);margin-bottom:6px;line-height:1.4;}
.ec-meta{font-size:0.82rem;color:var(--text-muted);line-height:1.6;margin-bottom:auto;}
.ec-meta span{display:block;}
.ec-footer{display:flex;align-items:center;justify-content:space-between;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);}
.ec-price{font-size:0.95rem;font-weight:600;color:var(--text);}
.ec-price small{font-weight:400;color:var(--text-light);font-size:0.75rem;margin-left:2px;}
.ec-btn{background:var(--cream);color:var(--text);border:1px solid var(--border-hover);border-radius:50px;padding:0.4rem 1rem;font-size:0.82rem;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all 0.18s;}
.ec-btn:hover{background:var(--sage);color:white;border-color:var(--sage);}
.theme-sage{background:linear-gradient(135deg,#EEF4EE 0%,#C4D8C4 100%);}
.theme-peach{background:linear-gradient(135deg,#FBF0EB 0%,#F5D4C4 100%);}
.theme-sky{background:linear-gradient(135deg,#EBF3F8 0%,#C4DBE8 100%);}
.theme-lavender{background:linear-gradient(135deg,#F3EEF9 0%,#D4BEE8 100%);}
.theme-butter{background:linear-gradient(135deg,#FBF7EB 0%,#F0DFA8 100%);}
.badge-zene{background:#EEF4EE;color:#4a7a4a;}
.badge-sport{background:#EBF3F8;color:#2a6080;}
.badge-gasztro{background:#FBF0EB;color:#9c5030;}
.badge-kultura{background:#F3EEF9;color:#6a3a9a;}
.badge-tech{background:#FBF7EB;color:#8c6010;}
.badge-termeszet{background:#EEF4EE;color:#3a6a3a;}
.no-results{padding:3rem;text-align:center;color:var(--text-muted);font-size:1rem;grid-column:1/-1;}

/* CALENDAR */
.calendar-page{padding:7rem 2.5rem 4rem;max-width:1100px;margin:0 auto;}
.cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
.cal-title{font-family:'Playfair Display',serif;font-size:2rem;font-weight:600;color:var(--text);}
.cal-nav{display:flex;align-items:center;gap:1rem;}
.cal-nav-btn{background:var(--white);border:1px solid var(--border-hover);border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;transition:all 0.18s;font-family:inherit;}
.cal-nav-btn:hover{background:var(--sage);color:white;border-color:var(--sage);}
.cal-month-label{font-size:1.1rem;font-weight:500;color:var(--text);min-width:170px;text-align:center;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--border);border-radius:16px;overflow:hidden;border:1px solid var(--border);}
.cal-day-name{background:var(--sage-pale);padding:0.6rem;text-align:center;font-size:0.75rem;font-weight:500;color:var(--text-muted);}
.cal-day{background:var(--white);padding:0.5rem;min-height:96px;cursor:pointer;transition:background 0.15s;position:relative;vertical-align:top;}
.cal-day:hover{background:var(--sage-pale);}
.cal-day.other-month .cal-day-num{color:var(--text-light);}
.cal-day-num{font-size:0.85rem;font-weight:500;color:var(--text);margin-bottom:4px;width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:50%;}
.cal-day.today .cal-day-num{background:var(--sage);color:white;}
.cal-event-chip{font-size:0.67rem;border-radius:5px;padding:2px 6px;margin-bottom:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer;border-left:2px solid var(--sage);background:var(--sage-pale);color:var(--brown-soft);transition:all 0.15s;display:block;}
.cal-event-chip:hover{background:var(--sage);color:white;border-left-color:white;}
.chip-peach{background:var(--peach-pale);border-left-color:var(--peach);color:#7a3a20;}
.chip-peach:hover{background:var(--peach);color:white;}
.chip-sky{background:var(--sky-pale);border-left-color:var(--sky);color:#1a5070;}
.chip-sky:hover{background:var(--sky);color:white;}
.chip-lavender{background:var(--lavender-pale);border-left-color:var(--lavender);color:#5a2a8a;}
.chip-lavender:hover{background:var(--lavender);color:white;}
.chip-butter{background:var(--butter-pale);border-left-color:var(--butter);color:#6a4a10;}
.chip-butter:hover{background:var(--butter);color:white;}
.cal-more{font-size:0.67rem;color:var(--text-light);padding:1px 4px;}
.cal-legend{display:flex;flex-wrap:wrap;gap:14px;margin-top:1.25rem;}
.cal-leg{display:flex;align-items:center;gap:6px;font-size:0.8rem;color:var(--text-muted);}
.cal-leg-dot{width:10px;height:10px;border-radius:3px;}

/* AUTH MODAL */
.auth-overlay{display:none;position:fixed;inset:0;z-index:300;background:rgba(45,40,32,0.55);backdrop-filter:blur(5px);align-items:center;justify-content:center;}
.auth-overlay.open{display:flex;}
.auth-box{background:var(--white);border-radius:24px;padding:2.5rem;width:100%;max-width:400px;animation:fadeUp 0.28s ease;position:relative;}
.auth-close-btn{position:absolute;top:1rem;right:1.2rem;background:none;border:none;font-size:1.5rem;cursor:pointer;color:var(--text-light);line-height:1;}
.auth-logo{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:600;color:var(--brown-soft);text-align:center;margin-bottom:0.3rem;}
.auth-logo span{color:var(--sage);}
.auth-subtitle{text-align:center;font-size:0.88rem;color:var(--text-muted);margin-bottom:1.5rem;}
.auth-tabs{display:flex;border-radius:12px;overflow:hidden;border:1px solid var(--border);margin-bottom:1.4rem;}
.auth-tab{flex:1;padding:0.65rem;text-align:center;font-size:0.88rem;cursor:pointer;background:var(--cream);color:var(--text-muted);transition:all 0.18s;font-family:'DM Sans',sans-serif;border:none;}
.auth-tab.active{background:var(--sage);color:white;font-weight:500;}
.auth-field{margin-bottom:0.9rem;}
.auth-label{font-size:0.8rem;font-weight:500;color:var(--text-muted);margin-bottom:4px;display:block;}
.auth-input{width:100%;border:1px solid var(--border-hover);border-radius:12px;padding:0.7rem 1rem;font-family:'DM Sans',sans-serif;font-size:0.9rem;color:var(--text);background:var(--cream);outline:none;transition:border-color 0.2s;}
.auth-input:focus{border-color:var(--sage);background:var(--white);}
.auth-submit{width:100%;background:var(--sage);color:white;border:none;padding:0.9rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:500;cursor:pointer;margin-top:0.5rem;transition:background 0.2s;}
.auth-submit:hover{background:#7a9e7a;}
.auth-err{color:#c0392b;font-size:0.82rem;margin-top:4px;display:none;}

/* BOOKING MODAL */
.modal-overlay{display:none;position:fixed;inset:0;z-index:250;background:rgba(45,40,32,0.5);backdrop-filter:blur(4px);align-items:flex-end;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:var(--white);border-radius:28px 28px 0 0;width:100%;max-width:520px;max-height:92vh;overflow-y:auto;animation:slideUp 0.3s cubic-bezier(.22,1,.36,1);}
@keyframes slideUp{from{transform:translateY(80px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.modal-handle-bar{display:flex;justify-content:center;padding:1rem 1rem 0;}
.modal-handle{width:40px;height:4px;background:var(--border-hover);border-radius:2px;}
.modal-inner{padding:1.25rem 1.75rem 2rem;}
.modal-header{display:flex;gap:1rem;align-items:center;margin-bottom:1.25rem;}
.modal-icon{font-size:2.8rem;}
.modal-ht h2{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:600;color:var(--text);}
.modal-ht p{font-size:0.83rem;color:var(--text-muted);margin-top:2px;}
.fb-box{background:linear-gradient(135deg,#e8f0fe,#d2e3fc);border:1px solid #b8d0f8;border-radius:16px;padding:1.25rem;margin:1rem 0;text-align:center;}
.fb-box-icon{font-size:2.4rem;margin-bottom:0.5rem;}
.fb-box h3{font-size:0.95rem;font-weight:600;color:#1a237e;margin-bottom:0.4rem;}
.fb-box p{font-size:0.82rem;color:#3949ab;line-height:1.55;}
.fb-link{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;background:#1877f2;color:white;border:none;padding:0.9rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-size:0.92rem;font-weight:500;cursor:pointer;margin-top:1rem;transition:background 0.2s;text-decoration:none;}
.fb-link:hover{background:#1464d8;}
.info-item{display:flex;gap:8px;align-items:flex-start;margin-bottom:7px;}
.info-dot{width:6px;height:6px;border-radius:50%;background:var(--sage);margin-top:6px;flex-shrink:0;}
.info-text{font-size:0.82rem;color:var(--text-muted);line-height:1.5;}
.modal-close-btn{width:100%;background:var(--cream);color:var(--text-muted);border:1px solid var(--border-hover);padding:0.75rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-size:0.88rem;cursor:pointer;margin-top:0.75rem;transition:all 0.18s;}
.modal-close-btn:hover{background:var(--sage-pale);}
.login-prompt{background:var(--peach-pale);border:1px solid var(--peach-light);border-radius:14px;padding:1.1rem;text-align:center;margin:0.75rem 0;}
.login-prompt p{font-size:0.85rem;color:var(--text-muted);margin-bottom:0.75rem;line-height:1.5;}
.login-prompt-btn{background:var(--brown-soft);color:white;border:none;padding:0.6rem 1.3rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-size:0.85rem;cursor:pointer;font-weight:500;transition:opacity 0.2s;}
.login-prompt-btn:hover{opacity:0.85;}

footer{background:var(--white);border-top:1px solid var(--border);padding:2.5rem;text-align:center;color:var(--text-light);font-size:0.82rem;}
footer strong{color:var(--text-muted);font-weight:500;}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
.fade-in{animation:fadeUp 0.5s ease both;}

#toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);background:var(--brown-soft);color:white;padding:0.75rem 1.5rem;border-radius:50px;font-size:0.88rem;z-index:999;opacity:0;transition:opacity 0.3s;pointer-events:none;white-space:nowrap;}

@media(max-width:768px){
  nav{padding:1rem 1.25rem;}
  .hero{grid-template-columns:1fr;padding:6rem 1.25rem 2rem;min-height:auto;gap:2rem;}
  .hero-visual{display:none;}
  .featured-section,.cats-section,.events-section{padding-left:1.25rem;padding-right:1.25rem;}
  .featured-card{grid-template-columns:1fr;}
  .featured-img{min-height:130px;}
