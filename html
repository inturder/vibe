function fmtDate(d){ const dt=new Date(d); return dt.toLocaleDateString('hu-HU',{month:'long',day:'numeric'}); }

// TOAST
function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.style.opacity='1'; clearTimeout(t._t); t._t=setTimeout(()=>{t.style.opacity='0';},3200); }

// AUTH
let me = JSON.parse(localStorage.getItem('vibe_me')||'null');

function renderNav(){
  const el=document.getElementById('nav-auth');
  if(me){
    const ini=me.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();
    el.innerHTML=`<div class="nav-user"><div class="nav-avatar">${ini}</div><span style="font-size:0.85rem;color:var(--text-muted)">${me.name.split(' ')[0]}</span><a style="font-size:0.75rem;color:var(--text-light)" onclick="doLogout()">Kilépés</a></div>`;
  } else {
    el.innerHTML=`<a class="nav-cta" onclick="openAuth()">Regisztráció</a>`;
  }
}

function openAuth(){ document.getElementById('authOverlay').classList.add('open'); switchTab('login'); }
function closeAuth(){ document.getElementById('authOverlay').classList.remove('open'); }

function switchTab(tab){
  document.getElementById('tab-login').classList.toggle('active',tab==='login');
  document.getElementById('tab-reg').classList.toggle('active',tab==='register');
  const f=document.getElementById('authForm');
  if(tab==='login'){
    document.getElementById('authSub').textContent='Jelentkezz be a fiókodba';
    f.innerHTML=`
      <div class="auth-field"><label class="auth-label">E-mail</label><input class="auth-input" id="li-e" type="email" placeholder="anna@example.hu"/></div>
      <div class="auth-field"><label class="auth-label">Jelszó</label><input class="auth-input" id="li-p" type="password" placeholder="••••••••"/></div>
      <div class="auth-err" id="li-err">Hibás e-mail vagy jelszó.</div>
      <button class="auth-submit" onclick="doLogin()">Bejelentkezés</button>
      <p style="text-align:center;font-size:0.8rem;color:var(--text-light);margin-top:1rem">Még nincs fiókod? <span style="color:var(--sage);cursor:pointer" onclick="switchTab('register')">Regisztrálj!</span></p>`;
  } else {
    document.getElementById('authSub').textContent='Csatlakozz a vibe közösséghez!';
    f.innerHTML=`
      <div class="auth-field"><label class="auth-label">Teljes neved</label><input class="auth-input" id="rg-n" type="text" placeholder="Kovács Anna"/></div>
      <div class="auth-field"><label class="auth-label">E-mail</label><input class="auth-input" id="rg-e" type="email" placeholder="anna@example.hu"/></div>
      <div class="auth-field"><label class="auth-label">Jelszó (min. 6 karakter)</label><input class="auth-input" id="rg-p" type="password" placeholder="••••••••"/></div>
      <div class="auth-err" id="rg-err"></div>
      <button class="auth-submit" onclick="doRegister()">Regisztráció</button>
      <p style="text-align:center;font-size:0.8rem;color:var(--text-light);margin-top:1rem">Van már fiókod? <span style="color:var(--sage);cursor:pointer" onclick="switchTab('login')">Lépj be!</span></p>`;
  }
}

function doLogin(){
  const e=document.getElementById('li-e').value.trim();
  const p=document.getElementById('li-p').value;
  const users=JSON.parse(localStorage.getItem('vibe_users')||'[]');
  const u=users.find(x=>x.email===e&&x.pass===p);
  if(!u){ document.getElementById('li-err').style.display='block'; return; }
  me=u; localStorage.setItem('vibe_me',JSON.stringify(u));
  closeAuth(); renderNav(); toast('Üdvözlünk vissza, '+u.name.split(' ')[0]+'! 👋');
}

function doRegister(){
  const n=document.getElementById('rg-n').value.trim();
  const e=document.getElementById('rg-e').value.trim();
  const p=document.getElementById('rg-p').value;
  const err=document.getElementById('rg-err');
  err.style.display='none';
  if(!n){ err.textContent='Add meg a neved!'; err.style.display='block'; return; }
  if(!e||!e.includes('@')){ err.textContent='Érvényes e-mail kell!'; err.style.display='block'; return; }
  if(p.length<6){ err.textContent='A jelszó legalább 6 karakter!'; err.style.display='block'; return; }
  const users=JSON.parse(localStorage.getItem('vibe_users')||'[]');
  if(users.find(x=>x.email===e)){ err.textContent='Ez az e-mail már regisztrált!'; err.style.display='block'; return; }
  const u={name:n,email:e,pass:p};
  users.push(u); localStorage.setItem('vibe_users',JSON.stringify(users));
  me=u; localStorage.setItem('vibe_me',JSON.stringify(u));
  closeAuth(); renderNav(); toast('Sikeres regisztráció, '+n.split(' ')[0]+'! 🎉 Örülünk, hogy itt vagy!');
}

function doLogout(){ me=null; localStorage.removeItem('vibe_me'); renderNav(); toast('Sikeresen kijelentkeztél. Viszlát! 👋'); }

// BOOKING MODAL
